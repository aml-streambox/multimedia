#version 450

// AMLY (40-bit packed YUV422 10-bit) to NV12 (semi-planar 8-bit) conversion
//
// Hardware writes with WORDS_SWAP=1 + WR_ENDIAN=0 (big endian).
// Correction: bswap64 each 64-bit word during tile load into shared memory.
//
// Workgroup: 128 threads x 1 row.
// Each thread processes 2 consecutive pixel pairs (4 pixels -> 4 Y bytes packed).
// Tile = 256 pairs = 1280 bytes = 320 uint32 words + 2 guard.
//
// Component order in 40-bit after bswap64 correction:
// The corrected bytes are in big-endian order within each 40-bit group.
// When loaded as LE uint32 (lo) + 1 byte (hi), extract via bswap32(lo):
//   uint bs = bswap32(lo);
//   y0 = (bs >> 22) & 0x3FF
//   u0 = (bs >> 12) & 0x3FF
//   y1 = (bs >> 2)  & 0x3FF
//   v0 = ((bs & 0x3) << 8) | hi
//
// Color space conversion (hdr_mode == 1):
//   BT.2020 YCbCr 10-bit -> BT.709 YCbCr 8-bit using a YCbCr-domain matrix.
//
//   Mathematical derivation:
//     M_composite = RGB_to_YCbCr_709 * Gamut_2020_to_709 * YCbCr_to_RGB_2020
//   This yields a 3x3 matrix where the Y row is [1, ~0, ~0] — luma is
//   unchanged by gamut conversion. So Y_8 = Y_10 >> 2 (identical to SDR).
//   Only chroma needs a 2x2 matrix multiply:
//     Cb_8 = clamp(m00*(Cb_10-512) + m01*(Cr_10-512) + 128, 16, 240)
//     Cr_8 = clamp(m10*(Cb_10-512) + m11*(Cr_10-512) + 128, 16, 240)
//
//   This is the industry-standard approach: fold quantization scaling into the
//   color matrix so the GPU does a single multiply-add per component with no
//   intermediate normalize/denormalize steps.
//
// SDR mode (hdr_mode == 0):
//   Simple 10-bit to 8-bit truncation (val >> 2), no color space conversion.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    uint data[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer YOutputBuffer {
    uint data[];
} y_output;

layout(set = 0, binding = 2, std430) writeonly buffer UVOutputBuffer {
    uint data[];
} uv_output;

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint pairs_per_row;
    uint hdr_mode;    // 0 = SDR passthrough, 1 = BT.2020 -> BT.709 CSC
} params;

// 256 pairs * 5 bytes = 1280 bytes, + up to 3 bytes alignment + 8 bytes guard = 1291
// Worst case: (1291 + 3) / 4 = 323.5 -> 324 words
#define TILE_PAIRS 256u
#define TILE_BYTES (TILE_PAIRS * 5u)
#define TILE_WORDS ((TILE_BYTES + 3u + 8u) / 4u + 1u)  // 324

shared uint tile[TILE_WORDS];

// ============================================================
// BT.2020 -> BT.709 chroma conversion matrix (2x2)
//
// Derived from: M = Quant_709_8bit * Composite * Dequant_2020_10bit
// where Composite = RGB2YCbCr_709 * GamutMap * YCbCr2RGB_2020
//
// Luma row is [0.25, ~0, ~0] with offset ~0, equivalent to Y >> 2.
// Only the chroma 2x2 submatrix is needed:
//   Cb_8 = m00*(Cb_10 - 512) + m01*(Cr_10 - 512) + 128
//   Cr_8 = m10*(Cb_10 - 512) + m11*(Cr_10 - 512) + 128
// ============================================================
const float CSC_M00 =  0.2857988609;   // 224/896 * 1.14320
const float CSC_M01 =  0.0041541729;   // 224/896 * 0.01662
const float CSC_M10 = -0.0064098041;   // 224/896 * -0.02564
const float CSC_M11 =  0.4420313078;   // 224/896 * 1.76813

// Byte-swap a 32-bit word
uint bswap32(uint val) {
    return ((val & 0x000000FFu) << 24) |
           ((val & 0x0000FF00u) <<  8) |
           ((val & 0x00FF0000u) >>  8) |
           ((val & 0xFF000000u) >> 24);
}

// Load input words into shared memory with bswap64 correction.
void load_tile(uint base_word_idx, uint n_words) {
    uint lid = gl_LocalInvocationID.x;

    for (uint i = lid * 2u; i < n_words; i += 128u * 2u) {
        if (i + 1u < n_words) {
            uint w0 = input_buffer.data[base_word_idx + i];
            uint w1 = input_buffer.data[base_word_idx + i + 1u];
            // bswap64: swap words and byte-reverse each
            tile[i]      = bswap32(w1);
            tile[i + 1u] = bswap32(w0);
        } else if (i < n_words) {
            tile[i] = 0u;
        }
    }
    barrier();
}

// Extract 40-bit pair from shared memory tile with byte offset.
void extract_pair(uint local_pair, uint byte_offset_base,
                  out uint lo, out uint hi) {
    uint byte_off = byte_offset_base + local_pair * 5u;
    uint widx = byte_off >> 2;
    uint shift = (byte_off & 3u) << 3;

    uint w0 = tile[widx];
    uint w1 = tile[widx + 1u];

    if (shift == 0u) {
        lo = w0;
        hi = w1 & 0xFFu;
    } else {
        uint w2 = tile[widx + 2u];
        lo = (w0 >> shift) | (w1 << (32u - shift));
        hi = ((w1 >> shift) | (w2 << (32u - shift))) & 0xFFu;
    }
}

// Read a corrected 40-bit pair from global memory (for next-row UV reads).
void read_pair_global(uint pair_idx, out uint lo, out uint hi) {
    uint byte_offset = pair_idx * 5u;
    uint word_idx = byte_offset >> 2;
    uint shift = (byte_offset & 3u) << 3;

    uint p0 = word_idx;
    uint b0 = p0 & ~1u;
    uint r0a = input_buffer.data[b0];
    uint r0b = input_buffer.data[b0 + 1u];
    uint cw0 = ((p0 & 1u) == 0u) ? bswap32(r0b) : bswap32(r0a);

    uint p1 = word_idx + 1u;
    uint b1 = p1 & ~1u;
    uint cw1;
    if (b1 == b0) {
        cw1 = ((p1 & 1u) == 0u) ? bswap32(r0b) : bswap32(r0a);
    } else {
        uint r1a = input_buffer.data[b1];
        uint r1b = input_buffer.data[b1 + 1u];
        cw1 = ((p1 & 1u) == 0u) ? bswap32(r1b) : bswap32(r1a);
    }

    if (shift == 0u) {
        lo = cw0;
        hi = cw1 & 0xFFu;
    } else {
        uint p2 = word_idx + 2u;
        uint b2 = p2 & ~1u;
        uint cw2;
        if (b2 == b1) {
            if (b1 == b0) {
                cw2 = ((p2 & 1u) == 0u) ? bswap32(r0b) : bswap32(r0a);
            } else {
                uint r1a = input_buffer.data[b1];
                uint r1b = input_buffer.data[b1 + 1u];
                cw2 = ((p2 & 1u) == 0u) ? bswap32(r1b) : bswap32(r1a);
            }
        } else {
            uint r2a = input_buffer.data[b2];
            uint r2b = input_buffer.data[b2 + 1u];
            cw2 = ((p2 & 1u) == 0u) ? bswap32(r2b) : bswap32(r2a);
        }
        lo = (cw0 >> shift) | (cw1 << (32u - shift));
        hi = ((cw1 >> shift) | (cw2 << (32u - shift))) & 0xFFu;
    }
}

// Decode AMLY 40-bit pair into 10-bit Y0, U, Y1, V components.
void decode_pair(uint lo, uint hi, out uint y0, out uint u0, out uint y1, out uint v0) {
    uint bs = bswap32(lo);
    y0 = (bs >> 22) & 0x3FFu;
    u0 = (bs >> 12) & 0x3FFu;
    y1 = (bs >> 2)  & 0x3FFu;
    v0 = ((bs & 0x3u) << 8) | hi;
}

// BT.2020 -> BT.709 chroma conversion for a UV pair.
// Input: 10-bit Cb (u_10), Cr (v_10) in [64..960] limited range.
// Output: 8-bit Cb (u_8), Cr (v_8) in [16..240] limited range.
void csc_chroma(uint u_10, uint v_10, out uint u_8, out uint v_8) {
    float cb = float(u_10) - 512.0;
    float cr = float(v_10) - 512.0;
    u_8 = uint(clamp(CSC_M00 * cb + CSC_M01 * cr + 128.0, 16.0, 240.0));
    v_8 = uint(clamp(CSC_M10 * cb + CSC_M11 * cr + 128.0, 16.0, 240.0));
}

void main() {
    uint row = gl_WorkGroupID.y;
    uint lid = gl_LocalInvocationID.x;

    uint tile_start = gl_WorkGroupID.x * TILE_PAIRS;
    uint tile_pairs = min(TILE_PAIRS, params.pairs_per_row - tile_start);

    uint row_byte_start = row * params.pairs_per_row * 5u;
    uint tile_byte_start = row_byte_start + tile_start * 5u;
    uint base_word_idx = tile_byte_start >> 2;
    uint tile_byte_offset = tile_byte_start & 3u;

    uint tile_bytes_needed = tile_byte_offset + tile_pairs * 5u;
    uint n_words = (tile_bytes_needed + 3u) / 4u + 2u;
    if (n_words > TILE_WORDS) n_words = TILE_WORDS;

    // Cooperative tile load (ALL threads must participate for barrier)
    load_tile(base_word_idx, n_words);

    if (row >= params.height) return;

    // Each thread processes 2 consecutive pairs: pair_a, pair_b
    uint local_pair_a = lid * 2u;
    uint local_pair_b = lid * 2u + 1u;
    uint global_pair_a = tile_start + local_pair_a;

    if (local_pair_a >= tile_pairs) return;

    // --- Extract and decode pair A ---
    uint lo_a, hi_a;
    extract_pair(local_pair_a, tile_byte_offset, lo_a, hi_a);
    uint y0_a, u0_a, y1_a, v0_a;
    decode_pair(lo_a, hi_a, y0_a, u0_a, y1_a, v0_a);

    // --- Y plane: luma is Y_10 >> 2 in both SDR and CSC modes ---
    // (BT.2020->BT.709 gamut conversion does not change luma)
    uint y_word = (y0_a >> 2) | ((y1_a >> 2) << 8);

    if (local_pair_b < tile_pairs) {
        uint lo_b, hi_b;
        extract_pair(local_pair_b, tile_byte_offset, lo_b, hi_b);
        uint y0_b, u0_b, y1_b, v0_b;
        decode_pair(lo_b, hi_b, y0_b, u0_b, y1_b, v0_b);
        y_word |= ((y0_b >> 2) << 16) | ((y1_b >> 2) << 24);
    }

    uint y_byte_off = row * params.width + global_pair_a * 2u;
    y_output.data[y_byte_off >> 2] = y_word;

    // --- UV plane: even rows only, vertical 2:1 average ---
    if ((row & 1u) != 0u || row + 1u >= params.height) return;

    // Read next-row pair A from global memory
    uint next_pair_a = global_pair_a + params.pairs_per_row;
    uint nlo_a, nhi_a;
    read_pair_global(next_pair_a, nlo_a, nhi_a);
    uint ny0_a, nu0_a, ny1_a, nv0_a;
    decode_pair(nlo_a, nhi_a, ny0_a, nu0_a, ny1_a, nv0_a);

    // Average chroma from current and next row (in 10-bit domain)
    uint u_avg_a = (u0_a + nu0_a + 1u) >> 1;
    uint v_avg_a = (v0_a + nv0_a + 1u) >> 1;

    uint uv_word;

    if (params.hdr_mode != 0u) {
        // CSC mode: apply BT.2020->BT.709 2x2 chroma matrix
        uint u8_a, v8_a;
        csc_chroma(u_avg_a, v_avg_a, u8_a, v8_a);
        uv_word = (u8_a & 0xFFu) | ((v8_a & 0xFFu) << 8);
    } else {
        // SDR mode: simple 10->8 bit truncation
        uv_word = ((u_avg_a >> 2) & 0xFFu) | (((v_avg_a >> 2) & 0xFFu) << 8);
    }

    if (local_pair_b < tile_pairs) {
        // Re-extract pair B from tile for chroma (we need u0_b, v0_b)
        uint lo_b2, hi_b2;
        extract_pair(local_pair_b, tile_byte_offset, lo_b2, hi_b2);
        uint y0_b2, u0_b2, y1_b2, v0_b2;
        decode_pair(lo_b2, hi_b2, y0_b2, u0_b2, y1_b2, v0_b2);

        // Next-row pair B
        uint next_pair_b = global_pair_a + 1u + params.pairs_per_row;
        uint nlo_b, nhi_b;
        read_pair_global(next_pair_b, nlo_b, nhi_b);
        uint ny0_b, nu0_b, ny1_b, nv0_b;
        decode_pair(nlo_b, nhi_b, ny0_b, nu0_b, ny1_b, nv0_b);

        uint u_avg_b = (u0_b2 + nu0_b + 1u) >> 1;
        uint v_avg_b = (v0_b2 + nv0_b + 1u) >> 1;

        if (params.hdr_mode != 0u) {
            uint u8_b, v8_b;
            csc_chroma(u_avg_b, v_avg_b, u8_b, v8_b);
            uv_word |= ((u8_b & 0xFFu) << 16) | ((v8_b & 0xFFu) << 24);
        } else {
            uv_word |= (((u_avg_b >> 2) & 0xFFu) << 16) |
                        (((v_avg_b >> 2) & 0xFFu) << 24);
        }
    }

    uint uv_row = row >> 1;
    uint uv_byte_off = uv_row * params.width + global_pair_a * 2u;
    uv_output.data[uv_byte_off >> 2] = uv_word;
}
