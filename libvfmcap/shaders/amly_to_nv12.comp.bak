#version 450

// AMLY (40-bit packed YUV422 10-bit) to NV12 (semi-planar 8-bit) conversion
//
// Hardware writes with WORDS_SWAP=1 + WR_ENDIAN=0 (big endian).
// Correction: bswap64 each 64-bit word during tile load into shared memory.
//
// Performance-optimized structure: 64 threads, 2 pairs per thread.
// Workgroup: 64 threads x 1 row.
// Each thread processes 2 consecutive pixel pairs (4 pixels = 4 Y bytes = 1 uint32).
// Tile = 128 pairs = 640 bytes = 160 uint32 words + guard (same as P010).
// Output writes are naturally 32-bit aligned with ZERO inter-thread coordination.
// Only 1 barrier (tile load) — no shared-memory LUT.
//
// HDR mode (hdr_mode == 1): Full HDR10 PQ -> SDR BT.709 pipeline
//   PQ EOTF computed inline (no shared memory LUT — LUT was 1KB and killed
//   GPU occupancy on Mali-G52, dropping from 60fps to 31fps even in SDR mode)
//   sRGB gamma via fast sqrt-polynomial approximation
//   Chroma: average YUV in PQ domain, run pipeline once per chroma sample
//
// SDR mode (hdr_mode == 0):
//   Simple 10-bit to 8-bit truncation (val >> 2), no color space conversion.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    uint data[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer YOutputBuffer {
    uint data[];
} y_output;

layout(set = 0, binding = 2, std430) writeonly buffer UVOutputBuffer {
    uint data[];
} uv_output;

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint pairs_per_row;
    uint hdr_mode;    // 0 = SDR passthrough, 1 = HDR10 PQ -> SDR BT.709
} params;

// Tile: 128 pairs * 5 bytes = 640 bytes, + up to 3 bytes alignment + 8 bytes guard
#define TILE_PAIRS 128u
#define TILE_BYTES (TILE_PAIRS * 5u)
#define TILE_WORDS ((TILE_BYTES + 3u + 8u) / 4u + 1u)  // 164

shared uint tile[TILE_WORDS];

// PQ EOTF constants
const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.8359375;
const float PQ_C2 = 18.8515625;
const float PQ_C3 = 18.6875;

// HDR tone mapping
const float REF_WHITE    = 203.0;
const float INV_REF_WHITE = 1.0 / 203.0;
const float SHOULDER     = 0.15;
const float SAT_BOOST    = 1.1;

// BT.2020 -> BT.709 gamut mapping
const float G20_00 =  1.6605; const float G20_01 = -0.5877; const float G20_02 = -0.0728;
const float G20_10 = -0.1246; const float G20_11 =  1.1329; const float G20_12 = -0.0083;
const float G20_20 = -0.0182; const float G20_21 = -0.1006; const float G20_22 =  1.1187;

// BT.2020 NCL YCbCr -> R'G'B'
const float BT2020_CR_TO_R =  1.4746;
const float BT2020_CB_TO_G = -0.1646;
const float BT2020_CR_TO_G = -0.5714;
const float BT2020_CB_TO_B =  1.8814;

// BT.709 R'G'B' -> Y'CbCr (8-bit limited)
const float BT709_YR = 0.2126;
const float BT709_YG = 0.7152;
const float BT709_YB = 0.0722;
const float BT709_CB_SCALE = 1.0 / 1.8556;
const float BT709_CR_SCALE = 1.0 / 1.5748;

// ============================================================
// Utility functions
// ============================================================
uint bswap32(uint val) {
    return ((val & 0x000000FFu) << 24) |
           ((val & 0x0000FF00u) <<  8) |
           ((val & 0x00FF0000u) >>  8) |
           ((val & 0xFF000000u) >> 24);
}

void load_tile(uint base_word_idx, uint n_words) {
    uint lid = gl_LocalInvocationID.x;
    // 64 threads, each loads pairs of words.  64 * 2 * ceil = covers 164 words.
    for (uint i = lid * 2u; i < n_words; i += 64u * 2u) {
        if (i + 1u < n_words) {
            uint w0 = input_buffer.data[base_word_idx + i];
            uint w1 = input_buffer.data[base_word_idx + i + 1u];
            tile[i]      = bswap32(w1);
            tile[i + 1u] = bswap32(w0);
        } else if (i < n_words) {
            tile[i] = 0u;
        }
    }
    // No barrier here — caller manages it
}

void extract_pair(uint local_pair, uint byte_offset_base,
                  out uint lo, out uint hi) {
    uint byte_off = byte_offset_base + local_pair * 5u;
    uint widx = byte_off >> 2;
    uint shift = (byte_off & 3u) << 3;
    uint w0 = tile[widx];
    uint w1 = tile[widx + 1u];
    if (shift == 0u) {
        lo = w0;
        hi = w1 & 0xFFu;
    } else {
        uint w2 = tile[widx + 2u];
        lo = (w0 >> shift) | (w1 << (32u - shift));
        hi = ((w1 >> shift) | (w2 << (32u - shift))) & 0xFFu;
    }
}

void decode_pair(uint lo, uint hi, out uint y0, out uint u0, out uint y1, out uint v0) {
    uint bs = bswap32(lo);
    y0 = (bs >> 22) & 0x3FFu;
    u0 = (bs >> 12) & 0x3FFu;
    y1 = (bs >> 2)  & 0x3FFu;
    v0 = ((bs & 0x3u) << 8) | hi;
}

void read_pair_global(uint pair_idx, out uint lo, out uint hi) {
    uint byte_offset = pair_idx * 5u;
    uint word_idx = byte_offset >> 2;
    uint shift = (byte_offset & 3u) << 3;

    uint p0 = word_idx;
    uint b0 = p0 & ~1u;
    uint r0a = input_buffer.data[b0];
    uint r0b = input_buffer.data[b0 + 1u];
    uint cw0 = ((p0 & 1u) == 0u) ? bswap32(r0b) : bswap32(r0a);

    uint p1 = word_idx + 1u;
    uint b1 = p1 & ~1u;
    uint cw1;
    if (b1 == b0) {
        cw1 = ((p1 & 1u) == 0u) ? bswap32(r0b) : bswap32(r0a);
    } else {
        uint r1a = input_buffer.data[b1];
        uint r1b = input_buffer.data[b1 + 1u];
        cw1 = ((p1 & 1u) == 0u) ? bswap32(r1b) : bswap32(r1a);
    }

    if (shift == 0u) {
        lo = cw0;
        hi = cw1 & 0xFFu;
    } else {
        uint p2 = word_idx + 2u;
        uint b2 = p2 & ~1u;
        uint cw2;
        if (b2 == b1) {
            if (b1 == b0) {
                cw2 = ((p2 & 1u) == 0u) ? bswap32(r0b) : bswap32(r0a);
            } else {
                uint r1a = input_buffer.data[b1];
                uint r1b = input_buffer.data[b1 + 1u];
                cw2 = ((p2 & 1u) == 0u) ? bswap32(r1b) : bswap32(r1a);
            }
        } else {
            uint r2a = input_buffer.data[b2];
            uint r2b = input_buffer.data[b2 + 1u];
            cw2 = ((p2 & 1u) == 0u) ? bswap32(r2b) : bswap32(r2a);
        }
        lo = (cw0 >> shift) | (cw1 << (32u - shift));
        hi = ((cw1 >> shift) | (cw2 << (32u - shift))) & 0xFFu;
    }
}

// ============================================================
// PQ EOTF (inline computation, scaled by 1/REF_WHITE)
// ============================================================
float pq_eotf_scaled(float E) {
    float Ep = max(E, 0.0);
    float Ep_pow = pow(Ep, 1.0 / PQ_M2);
    float num = max(Ep_pow - PQ_C1, 0.0);
    float den = max(PQ_C2 - PQ_C3 * Ep_pow, 1e-6);
    return pow(num / den, 1.0 / PQ_M1) * 10000.0 * INV_REF_WHITE;
}

// ============================================================
// Fast polynomial gamma
// ============================================================
float fast_gamma(float x) {
    float s = sqrt(max(x, 0.0));
    return clamp(s * (1.30283059 + s * (-0.97414567 + s * (1.52167224
                 + s * (-1.25630661 + s * 0.40636588)))), 0.0, 1.0);
}

// ============================================================
// HDR10 PQ -> SDR BT.709 pipeline (inline PQ + polynomial gamma)
// ============================================================
void hdr10_to_sdr_rgb(float y10, float cb10, float cr10,
                      out float r_out, out float g_out, out float b_out) {
    float Y  = clamp((y10  - 64.0) / 876.0, 0.0, 1.0);
    float Cb = (cb10 - 512.0) / 896.0;
    float Cr = (cr10 - 512.0) / 896.0;

    float Rpq = clamp(Y + BT2020_CR_TO_R * Cr, 0.0, 1.0);
    float Gpq = clamp(Y + BT2020_CB_TO_G * Cb + BT2020_CR_TO_G * Cr, 0.0, 1.0);
    float Bpq = clamp(Y + BT2020_CB_TO_B * Cb, 0.0, 1.0);

    float rn = pq_eotf_scaled(Rpq);
    float gn = pq_eotf_scaled(Gpq);
    float bn = pq_eotf_scaled(Bpq);

    float R709 = max(G20_00 * rn + G20_01 * gn + G20_02 * bn, 0.0);
    float G709 = max(G20_10 * rn + G20_11 * gn + G20_12 * bn, 0.0);
    float B709 = max(G20_20 * rn + G20_21 * gn + G20_22 * bn, 0.0);

    float rt = clamp(R709 / (1.0 + SHOULDER * R709), 0.0, 1.0);
    float gt = clamp(G709 / (1.0 + SHOULDER * G709), 0.0, 1.0);
    float bt = clamp(B709 / (1.0 + SHOULDER * B709), 0.0, 1.0);

    float luma = BT709_YR * rt + BT709_YG * gt + BT709_YB * bt;
    rt = clamp(luma + SAT_BOOST * (rt - luma), 0.0, 1.0);
    gt = clamp(luma + SAT_BOOST * (gt - luma), 0.0, 1.0);
    bt = clamp(luma + SAT_BOOST * (bt - luma), 0.0, 1.0);

    r_out = fast_gamma(rt);
    g_out = fast_gamma(gt);
    b_out = fast_gamma(bt);
}

void rgb709_to_ycbcr8(float R, float G, float B,
                      out uint Y8, out uint Cb8, out uint Cr8) {
    float Yf  = BT709_YR * R + BT709_YG * G + BT709_YB * B;
    float Cbf = (B - Yf) * BT709_CB_SCALE;
    float Crf = (R - Yf) * BT709_CR_SCALE;
    Y8  = uint(clamp(Yf  * 219.0 + 16.0, 16.0, 235.0));
    Cb8 = uint(clamp(Cbf * 224.0 + 128.0, 16.0, 240.0));
    Cr8 = uint(clamp(Crf * 224.0 + 128.0, 16.0, 240.0));
}

// ============================================================
// Main: 2 pairs per thread (64 threads), zero output barriers
// ============================================================
void main() {
    uint row = gl_WorkGroupID.y;
    uint lid = gl_LocalInvocationID.x;

    uint tile_start = gl_WorkGroupID.x * TILE_PAIRS;
    uint tile_pairs = min(TILE_PAIRS, params.pairs_per_row - tile_start);

    uint row_byte_start = row * params.pairs_per_row * 5u;
    uint tile_byte_start = row_byte_start + tile_start * 5u;
    uint base_word_idx = tile_byte_start >> 2;
    uint tile_byte_offset = tile_byte_start & 3u;

    uint tile_bytes_needed = tile_byte_offset + tile_pairs * 5u;
    uint n_words = (tile_bytes_needed + 3u) / 4u + 2u;
    if (n_words > TILE_WORDS) n_words = TILE_WORDS;

    // Load tile, then barrier for shared memory
    load_tile(base_word_idx, n_words);
    barrier();

    if (row >= params.height) return;

    // Each thread handles 2 consecutive pairs: pair_a and pair_b
    uint local_pair_a = lid * 2u;
    uint local_pair_b = lid * 2u + 1u;
    uint global_pair_a = tile_start + local_pair_a;
    uint global_pair_b = tile_start + local_pair_b;

    bool has_a = (local_pair_a < tile_pairs);
    bool has_b = (local_pair_b < tile_pairs);

    if (!has_a) return;

    // Extract and decode pair A
    uint lo_a, hi_a;
    extract_pair(local_pair_a, tile_byte_offset, lo_a, hi_a);
    uint y0_a, u0_a, y1_a, v0_a;
    decode_pair(lo_a, hi_a, y0_a, u0_a, y1_a, v0_a);

    // Extract and decode pair B (if it exists)
    uint y0_b, u0_b, y1_b, v0_b;
    if (has_b) {
        uint lo_b, hi_b;
        extract_pair(local_pair_b, tile_byte_offset, lo_b, hi_b);
        decode_pair(lo_b, hi_b, y0_b, u0_b, y1_b, v0_b);
    }

    // --- Y plane: 4 Y bytes from 2 pairs = 1 uint32 write per thread ---
    uint y_word;
    if (params.hdr_mode != 0u) {
        // HDR: full pipeline for each pixel
        float r0a, g0a, b0a, r1a, g1a, b1a;
        hdr10_to_sdr_rgb(float(y0_a), float(u0_a), float(v0_a), r0a, g0a, b0a);
        hdr10_to_sdr_rgb(float(y1_a), float(u0_a), float(v0_a), r1a, g1a, b1a);
        uint Y8_0a, Cb_ign, Cr_ign, Y8_1a;
        rgb709_to_ycbcr8(r0a, g0a, b0a, Y8_0a, Cb_ign, Cr_ign);
        rgb709_to_ycbcr8(r1a, g1a, b1a, Y8_1a, Cb_ign, Cr_ign);

        if (has_b) {
            float r0b, g0b, b0b, r1b, g1b, b1b;
            hdr10_to_sdr_rgb(float(y0_b), float(u0_b), float(v0_b), r0b, g0b, b0b);
            hdr10_to_sdr_rgb(float(y1_b), float(u0_b), float(v0_b), r1b, g1b, b1b);
            uint Y8_0b, Y8_1b;
            rgb709_to_ycbcr8(r0b, g0b, b0b, Y8_0b, Cb_ign, Cr_ign);
            rgb709_to_ycbcr8(r1b, g1b, b1b, Y8_1b, Cb_ign, Cr_ign);
            y_word = (Y8_0a & 0xFFu) | ((Y8_1a & 0xFFu) << 8)
                   | ((Y8_0b & 0xFFu) << 16) | ((Y8_1b & 0xFFu) << 24);
        } else {
            y_word = (Y8_0a & 0xFFu) | ((Y8_1a & 0xFFu) << 8);
        }
    } else {
        // SDR: simple 10->8 bit truncation
        uint ya0 = y0_a >> 2;
        uint ya1 = y1_a >> 2;
        if (has_b) {
            uint yb0 = y0_b >> 2;
            uint yb1 = y1_b >> 2;
            y_word = (ya0 & 0xFFu) | ((ya1 & 0xFFu) << 8)
                   | ((yb0 & 0xFFu) << 16) | ((yb1 & 0xFFu) << 24);
        } else {
            y_word = (ya0 & 0xFFu) | ((ya1 & 0xFFu) << 8);
        }
    }

    // Write Y: 4 bytes per thread (2 pairs * 2 Y pixels * 1 byte each)
    // global_pair_a * 2 = byte offset within row (2 pixels per pair, 1 byte each)
    uint y_byte_off = row * params.width + global_pair_a * 2u;
    y_output.data[y_byte_off >> 2] = y_word;

    // --- UV plane: even rows only, vertical 2:1 average with next row ---
    if ((row & 1u) != 0u || row + 1u >= params.height) return;

    // Read next-row pairs from global memory (absolute pair indices)
    uint abs_pair_a = row * params.pairs_per_row + global_pair_a;
    uint next_pair_a = abs_pair_a + params.pairs_per_row;

    uint nlo_a, nhi_a;
    read_pair_global(next_pair_a, nlo_a, nhi_a);
    uint ny0_a, nu0_a, ny1_a, nv0_a;
    decode_pair(nlo_a, nhi_a, ny0_a, nu0_a, ny1_a, nv0_a);

    uint uv_word;
    if (params.hdr_mode != 0u) {
        // Pair A chroma: PQ-domain average then pipeline
        float avg_y_a  = float(y0_a + y1_a + ny0_a + ny1_a) * 0.25;
        float avg_cb_a = float(u0_a + nu0_a) * 0.5;
        float avg_cr_a = float(v0_a + nv0_a) * 0.5;
        float ra, ga, ba;
        hdr10_to_sdr_rgb(avg_y_a, avg_cb_a, avg_cr_a, ra, ga, ba);
        uint Y8_ign, Cb8_a, Cr8_a;
        rgb709_to_ycbcr8(ra, ga, ba, Y8_ign, Cb8_a, Cr8_a);

        if (has_b) {
            // Pair B next-row
            uint abs_pair_b = abs_pair_a + 1u;
            uint next_pair_b = abs_pair_b + params.pairs_per_row;
            uint nlo_b, nhi_b;
            read_pair_global(next_pair_b, nlo_b, nhi_b);
            uint ny0_b, nu0_b, ny1_b, nv0_b;
            decode_pair(nlo_b, nhi_b, ny0_b, nu0_b, ny1_b, nv0_b);

            float avg_y_b  = float(y0_b + y1_b + ny0_b + ny1_b) * 0.25;
            float avg_cb_b = float(u0_b + nu0_b) * 0.5;
            float avg_cr_b = float(v0_b + nv0_b) * 0.5;
            float rb, gb, bb;
            hdr10_to_sdr_rgb(avg_y_b, avg_cb_b, avg_cr_b, rb, gb, bb);
            uint Cb8_b, Cr8_b;
            rgb709_to_ycbcr8(rb, gb, bb, Y8_ign, Cb8_b, Cr8_b);

            uv_word = (Cb8_a & 0xFFu) | ((Cr8_a & 0xFFu) << 8)
                    | ((Cb8_b & 0xFFu) << 16) | ((Cr8_b & 0xFFu) << 24);
        } else {
            uv_word = (Cb8_a & 0xFFu) | ((Cr8_a & 0xFFu) << 8);
        }
    } else {
        // SDR: average and truncate
        uint ua_avg = (u0_a + nu0_a + 1u) >> 1;
        uint va_avg = (v0_a + nv0_a + 1u) >> 1;
        if (has_b) {
            uint nlo_b, nhi_b;
            uint abs_pair_b = abs_pair_a + 1u;
            uint next_pair_b = abs_pair_b + params.pairs_per_row;
            read_pair_global(next_pair_b, nlo_b, nhi_b);
            uint ny0_b, nu0_b, ny1_b, nv0_b;
            decode_pair(nlo_b, nhi_b, ny0_b, nu0_b, ny1_b, nv0_b);

            uint ub_avg = (u0_b + nu0_b + 1u) >> 1;
            uint vb_avg = (v0_b + nv0_b + 1u) >> 1;
            uv_word = ((ua_avg >> 2) & 0xFFu) | (((va_avg >> 2) & 0xFFu) << 8)
                    | (((ub_avg >> 2) & 0xFFu) << 16) | (((vb_avg >> 2) & 0xFFu) << 24);
        } else {
            uv_word = ((ua_avg >> 2) & 0xFFu) | (((va_avg >> 2) & 0xFFu) << 8);
        }
    }

    // Write UV: 4 bytes per thread (2 pairs * (Cb + Cr) * 1 byte each)
    uint uv_row = row >> 1;
    uint uv_byte_off = uv_row * params.width + global_pair_a * 2u;
    uv_output.data[uv_byte_off >> 2] = uv_word;
}
