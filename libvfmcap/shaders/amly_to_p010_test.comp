#version 450

// SIMPLIFIED TEST: Just copy input to output to verify basic shader structure works

layout(local_size_x = 128, local_size_y = 2, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    uint data[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer YOutputBuffer {
    uint data[];
} y_output;

layout(set = 0, binding = 2, std430) writeonly buffer UVOutputBuffer {
    uint data[];
} uv_output;

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint pairs_per_row;
    uint hdr_mode;
} params;

void main() {
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;
    uint lid_x = gl_LocalInvocationID.x;
    uint lid_y = gl_LocalInvocationID.y;

    uint row = wg_y * 2u + lid_y;
    if (row >= params.height) return;

    uint global_pair = wg_x * 128u + lid_x;
    if (global_pair >= params.pairs_per_row) return;

    uint pair_idx = row * params.pairs_per_row + global_pair;
    
    // Simple passthrough - just copy some input data to output
    uint input_idx = (row * params.pairs_per_row * 5u / 4u) + lid_x;
    uint val = input_buffer.data[input_idx];
    
    // Write to Y output (simple test pattern)
    y_output.data[pair_idx] = val;
    
    // Write to UV output (only for even rows)
    if (lid_y == 0u && (row + 1u) < params.height) {
        uint uv_row = row >> 1;
        uint uv_idx = uv_row * params.pairs_per_row + global_pair;
        uv_output.data[uv_idx] = val;
    }
}
